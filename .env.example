# Solo NOMBRES de variables. Nunca pongas valores reales aquí.
# Los secretos reales viven en GitHub Secrets (Settings → Secrets and variables → Actions).

# --- Secretos (solo GitHub Secrets, usados por jobs/) ---
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
RAIDERIO_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Configuración no secreta de jobs ---
INTEGRATION_MODE=mock   # mock | manual | raiderio | blizzard

# --- Config pública de Firebase para el build web (no es secreta) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
